{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Trimmer",
  "version": "0.1.0",
  "identifier": "com.nrupesh.audiotrimmer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Trimmer",
        "width": 760,
        "height": 800,
        "minWidth": 560,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ]
  }
}
